[Unit]
Description=Lens — AI Protocol Translator
Documentation=https://github.com/YKaiXu/lens
After=network.target

[Service]
Type=simple
User=yupeng
WorkingDirectory=/home/yupeng/lens
ExecStart=/usr/bin/python3 -m aperture
Restart=always
RestartSec=5
EnvironmentFile=-/home/yupeng/lens/.env
Environment=API_KEY=your-api-key-here
Environment=UPSTREAM_BASE_URL=https://opencode.ai/zen/go/v1
Environment=APERTURE_HOST=127.0.0.1
Environment=APERTURE_PORT=8080
Environment=LOG_DIR=/home/yupeng/lens/logs

[Install]
WantedBy=multi-user.target
