# Lens Environment Configuration Template
# Copy this file to .env and configure your secrets

API_KEY=your-api-key-here
UPSTREAM_BASE_URL=https://opencode.ai/zen/go/v1
APERTURE_HOST=127.0.0.1
APERTURE_PORT=8080
LOG_DIR=/home/yupeng/lens/logs

# Model Configuration
BACKEND_MODEL=deepseek-v4-flash
ANTHROPIC_DISPLAY_MODEL=claude-fable-5
RESPONSES_DISPLAY_MODEL=gpt-5.6-sol
CHAT_DISPLAY_MODEL=gpt-5.6-sol

# Security Settings
AUTH_ALLOW_LOCAL=false

# Passthrough & Limits
PASSTHROUGH_MODE=false
UPSTREAM_RPM=39
UPSTREAM_CONCURRENCY=8
REQUEST_TIMEOUT_MS=120000
